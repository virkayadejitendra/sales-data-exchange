  "item": [
    {
      "name": "1. Health",
      "item": [
        {
          "name": "Liveness",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/health/live",
            "description": "Confirms that the FastAPI process is running."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Service is healthy', function () { pm.expect(pm.response.json().status).to.eql('ok'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Readiness",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/health/ready",
            "description": "Confirms that FastAPI can connect to PostgreSQL."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Database is ready', function () { pm.expect(pm.response.json().status).to.eql('ok'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Products",
      "item": [
        {
          "name": "Create Product",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('run_suffix', Date.now().toString());",
                  "pm.collectionVariables.unset('product_id');",
                  "pm.collectionVariables.unset('outlet_id');",
                  "pm.collectionVariables.unset('mapping_id');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('product_id', body.id);",
                  "pm.test('Product ID was returned', function () { pm.expect(body.id).to.be.a('string'); });",
                  "pm.test('Money is serialized without float leakage', function () { pm.expect(body.mrp).to.eql('65.00'); });",
                  "pm.test('SQLAlchemy internals are hidden', function () { pm.expect(body).not.to.have.property('_sa_instance_state'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"manufacturer_id\": \"{{manufacturer_id}}\",\n  \"manufacturer_sku\": \"DOVE-SOAP-{{run_suffix}}\",\n  \"name\": \"Dove Cream Beauty Bathing Bar\",\n  \"brand\": \"Dove\",\n  \"category\": \"Personal Care\",\n  \"subcategory\": \"Bathing Soap\",\n  \"variant\": \"Original\",\n  \"pack_size\": \"100.000\",\n  \"unit_of_measure\": \"GRAM\",\n  \"mrp\": \"65.00\"\n}"
            },
            "url": "{{base_url}}/api/v1/products",
            "description": "Creates a manufacturer-owned product and stores its ID for later requests."
          }
        },
        {
          "name": "Duplicate Product SKU - Expect 409",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"manufacturer_id\": \"{{manufacturer_id}}\",\n  \"manufacturer_sku\": \"DOVE-SOAP-{{run_suffix}}\",\n  \"name\": \"Duplicate Dove Product\",\n  \"brand\": \"Dove\",\n  \"category\": \"Personal Care\",\n  \"pack_size\": \"100.000\",\n  \"unit_of_measure\": \"GRAM\",\n  \"mrp\": \"65.00\"\n}"
            },
            "url": "{{base_url}}/api/v1/products",
            "description": "Demonstrates the manufacturer SKU uniqueness rule."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Duplicate SKU returns 409', function () { pm.response.to.have.status(409); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Product",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/v1/products/{{product_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Correct product returned', function () { pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('product_id')); });"
                ]
              }
            }
          ]
        },
        {
          "name": "List Products with Filters",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/v1/products?manufacturer_id={{manufacturer_id}}&brand=Dove&is_active=true&limit=20"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response is a list', function () { pm.expect(pm.response.json()).to.be.an('array'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Patch Product MRP",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mrp\": \"70.50\"\n}"
            },
            "url": "{{base_url}}/api/v1/products/{{product_id}}",
            "description": "Demonstrates a partial update: only MRP changes."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('MRP was updated', function () { pm.expect(pm.response.json().mrp).to.eql('70.50'); });"
                ]
              }
            }
          ]
        }
      ]
    },
